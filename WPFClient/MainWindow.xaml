<Window x:Class="WPFClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GDA Client" Height="800" Width="800">
    <Grid>
        <Grid.Resources>
            <Style x:Key="aeroCheckListBoxStyle" TargetType="{x:Type ListBox}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBox}">
                            <Border BorderBrush="Gray" BorderThickness="1" Background="{TemplateBinding Background}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CheckBoxItemTemplate">
                <CheckBox Margin="3" Content="{Binding}" IsChecked="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" />
            </DataTemplate>
        </Grid.Resources>

        <TabControl x:Name="TabControl">

            <TabItem Header="GetExtentValues">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Label Content="Izaberite Tip Elementa:" FontWeight="Bold" FontSize="14"/>
                        <ComboBox x:Name="cb_element_types" Height="30" Margin="0,5,0,15" ItemsSource="{Binding ComboBoxElementTypes}" SelectionChanged="cb_element_types_SelectionChanged"/>

                        <Label Content="Lista elemenata (kliknite na red za GetValues):" FontWeight="Bold" FontSize="14"/>
                        <DataGrid x:Name="dg_elements" Height="200" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="dg_elements_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="GID (Hex)" Binding="{Binding GidHex}" Width="150"/>
                                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Label Content="Detaljni podaci o izabranom elementu:" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                        <TextBox x:Name="richTextBox_2" Height="320" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" Background="White"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>



            <TabItem Header="GetRelatedValues">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Label Content="1. Izaberite element:" FontWeight="Bold"/>
                        <ComboBox x:Name="cbRelElements" Height="30" Margin="0,5,0,15" ItemsSource="{Binding ComboBoxRelElements}" DisplayMemberPath="Name" SelectedValuePath="GID" SelectionChanged="cbRelElements_SelectionChanged"/>

                        <Label Content="2. Izaberite relaciju:" FontWeight="Bold"/>
                        <ComboBox x:Name="cbRel" Height="30" Margin="0,5,0,15" ItemsSource="{Binding ComboBoxRels}" SelectionChanged="cbRel_SelectionChanged"/>

                        <!--"<Label Content="3. Izaberite atribut cilja:" FontWeight="Bold"/>
                        <ComboBox x:Name="cbRelAttributes" Height="30" Margin="0,5,0,15" ItemsSource="{Binding ComboBoxRelAttributes}"/>-->
                    </StackPanel>

                    <Button x:Name="btnShow" Grid.Row="1" Content="Prikazi" Height="40" Margin="0,10,0,10" Foreground="Black" FontWeight="Bold" Click="btnShow_Click"/>

                    <GroupBox Grid.Row="2" Header="Rezultati pretrage" Margin="0,10,0,0">
                        <TextBox x:Name="richTextBox_results2" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14" />
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>